# Supabase project URL and publishable (browser-safe) key.
# Found in Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The app's own public URL. Used to build auth email links (confirmation,
# password reset) so they don't point at localhost in production. Must also
# be added to Supabase's Authentication -> URL Configuration -> Redirect
# URLs allow list, or Supabase silently falls back to its Site URL default.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key. Server-only — never expose this to the browser, never
# prefix it with NEXT_PUBLIC_. Used for privileged operations like account
# deletion that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# USDA FoodData Central API key (server-only). Get one at
# https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Open Food Facts has no API key requirement today, but the app identifies
# itself via a User-Agent string per their usage policy.
OPEN_FOOD_FACTS_USER_AGENT=Slimorie/0.1 (contact: you@example.com)
